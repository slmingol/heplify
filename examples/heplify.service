# systemd unit for heplify
#
# Install (the deb/rpm packages do all of this, including creating the user):
#   groupadd --system heplify
#   useradd --system --gid heplify --home-dir /var/lib/heplify --no-create-home \
#       --shell /usr/sbin/nologin heplify
#   cp heplify.service /etc/systemd/system/
#   (the packages install the binary to /usr/bin/heplify; adjust ExecStart if
#   you installed it elsewhere, e.g. /usr/local/bin/heplify)
#   systemctl daemon-reload
#   systemctl enable --now heplify
#
# The packages install this unit to /usr/lib/systemd/system/; customize it with
# 'systemctl edit heplify' (drop-in) rather than by editing the file.
#
# The service runs unprivileged with only CAP_NET_RAW (packet capture) and
# CAP_NET_ADMIN (promiscuous mode), and the filesystem is read-only except
# /var/lib/heplify (StateDirectory, also the working directory: relative paths
# such as the HEP buffer file "hep-buffer.dump" end up there).
#
# Adjust it with a drop-in ('systemctl edit heplify'), for example:
#
# - The configuration writes outside /var/lib/heplify (pcap output file, ...):
#     [Service]
#     ReadWritePaths=/path/to/dir
#
# - A listener (collector, API, Prometheus) uses a port below 1024, e.g. UDP
#   514: binding it needs CAP_NET_BIND_SERVICE, which is not granted by default
#   (heplify then fails with "bind: permission denied"):
#     [Service]
#     AmbientCapabilities=CAP_NET_BIND_SERVICE
#     CapabilityBoundingSet=CAP_NET_BIND_SERVICE
#
# - Files named in the configuration (TLS certificates and keys, Lua scripts,
#   pcap files to read) must be readable by the heplify user and must not live
#   under /home or /root (ProtectHome=yes). For a key owned by another group,
#   add it with SupplementaryGroups=<group> in a drop-in.

[Unit]
Description=heplify - HEP Agent and Collector
Documentation=https://github.com/sipcapture/heplify
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment="HEPLIFY_CONFIG=/etc/heplify/heplify.json"
ExecStart=/usr/bin/heplify -config ${HEPLIFY_CONFIG}
Restart=always
RestartSec=3s
LimitNOFILE=65536

User=heplify
Group=heplify
StateDirectory=heplify
StateDirectoryMode=0750
WorkingDirectory=/var/lib/heplify
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN

# Sandboxing
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK AF_PACKET
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
